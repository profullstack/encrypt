  "author": "Profullstack, Inc.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/profullstack/encrypt.git"
  },
  "homepage": "https://github.com/profullstack/encrypt#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@noble/ciphers": "^2.0.0",
